<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="350.0" prefWidth="420.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gcm.lab2.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" text="GCM - User Login" textFill="#171553">
      <font>
         <Font name="System Bold" size="24.0" />
      </font></Label>
   <Label prefHeight="17.0" prefWidth="380.0" text="Username" textFill="#334155">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Label>
   <TextField fx:id="usernameField" promptText="Enter your email" />
   <Label prefWidth="380.0" text="Password" textFill="#334155">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Label>
   <PasswordField fx:id="passwordField" promptText="Enter your password" />

    <Button mnemonicParsing="false" onAction="#handleLogin" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 10; -fx-padding: 12 45 12 45;" text="Login" />

    <Label fx:id="errorLabel" text="Invalid username or password" textFill="#d91616" visible="false" />
</VBox>
